---
import SiteHead from '../components/SiteHead.astro';
import SiteBrand from '../components/SiteBrand.astro';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead title="Steven Mulvey Watters — Independent developer" description="Steven Mulvey Watters builds thoughtful, privacy-focused apps and practical web tools in Dublin." path="/" />
	</head>
	<body>
		<a class="skip-link" href="#top">Skip to main content</a>
		<header class="site-header shell">
			<SiteBrand href="#top" />
			<nav aria-label="Primary navigation"><a href="#work">Work</a><a href="/about/">About</a></nav>
		</header>

		<main id="top">
			<section class="hero shell" aria-labelledby="hero-title">
				<p class="eyebrow">Independent developer · Dublin</p>
				<h1 id="hero-title">I build useful<br />software for<br />real problems.</h1>
				<div class="hero-support">
					<p class="hero-copy">Independent developer and Configuration Analyst in Dublin, making privacy-focused apps and practical tools.</p>
					<a class="text-link" href="#work">View selected work <span aria-hidden="true">↓</span></a>
				</div>
			</section>

			<section id="work" class="project project-ardu" aria-labelledby="ardu-title">
				<div class="project-inner shell">
					<div class="project-copy">
						<p class="project-label">Ardu</p>
						<h2 id="ardu-title">Momentum, without the pressure of perfect streaks.</h2>
						<p>Ardu makes it easier to begin, adjust and keep going—with gentle planning, on-device intelligence and no judgement when life changes.</p>
						<ul class="tags" aria-label="Ardu technologies"><li>SwiftUI</li><li>On-device AI</li><li>iCloud</li></ul>
						<a class="project-link" href="/work/ardu/">Explore Ardu <span aria-hidden="true">→</span></a>
					</div>
					<div class="product-stage ardu-stage">
						<img src="/images/ardu-today.png" alt="Ardu Today screen showing a focused plan and a calm list of later tasks" loading="eager" fetchpriority="high" />
					</div>
				</div>
			</section>

			<section class="project project-squashr" aria-labelledby="squashr-title">
				<div class="project-inner shell">
					<div class="project-copy">
						<p class="project-label">Squashr</p>
						<h2 id="squashr-title">Tournament days, made simpler.</h2>
						<p>A WordPress tournament manager shaped around the way real squash clubs run draws, record results and keep players moving.</p>
						<ul class="tags" aria-label="Squashr technologies"><li>WordPress</li><li>PHP</li><li>Tournament tools</li></ul>
						<a class="project-link" href="/work/squashr/">Explore Squashr <span aria-hidden="true">→</span></a>
					</div>
					<div class="product-stage squashr-stage">
						<img src="/images/squashr-live-scoring-iphone.jpg" alt="Squashr live scoring on iPhone during game two, with Bob King on four points and John Doe serving on six" loading="lazy" decoding="async" />
					</div>
				</div>
			</section>

			<section id="about" class="about shell" aria-labelledby="about-title">
				<p class="eyebrow about-label">About</p>
				<div class="about-copy">
					<h2 id="about-title">Useful technology should feel human.</h2>
					<p>I’m Steven, a Configuration Analyst and independent developer based in Dublin. I enjoy solving practical problems, making complicated systems calmer and learning by building.</p>
					<p>Away from the keyboard, you’ll usually find me running, playing squash or disappearing down an entirely unnecessary technology rabbit hole.</p>
					<a class="about-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="shell footer-inner">
				<p class="eyebrow">Get in touch</p>
				<a class="footer-cta" href="mailto:hello@mulveywatters.ie">Let’s make<br />something useful.</a>
				<div class="footer-meta"><a href="mailto:hello@mulveywatters.ie">hello@mulveywatters.ie</a><span>Dublin, Ireland</span><span>© {year} Steven Mulvey Watters</span></div>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root { --paper:#f3f0e8; --ink:#11120f; --muted:#5e5d56; --ardu:#0868d7; --squashr:#064c34; --rule:rgba(17,18,15,.25); font-family:'DM Sans',system-ui,sans-serif; color:var(--ink); background:var(--paper); font-synthesis:none; }
	* { box-sizing:border-box; }
	html { scroll-behavior:smooth; }
	body { margin:0; background:var(--paper); }
	a { color:inherit; text-decoration:none; transition:opacity .2s ease; }
	a:hover { opacity:.65; }
	a:focus-visible { outline:2px solid currentColor; outline-offset:5px; }
	.skip-link { position:fixed; z-index:100; top:1rem; left:1rem; padding:.7rem 1rem; color:#fff; background:#11120f; border-radius:.25rem; transform:translateY(-200%); }
	.skip-link:focus { transform:none; }
	img { display:block; max-width:100%; }
	.shell { width:min(100% - 2rem,1180px); margin-inline:auto; }
	.site-header { display:flex; align-items:center; justify-content:space-between; padding-block:1.35rem; border-bottom:1px solid var(--rule); }
	.wordmark, nav a, .eyebrow, .project-label { font-size:.72rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; }
	nav { display:flex; gap:1.25rem; }
	nav a { letter-spacing:.04em; text-transform:none; }
	.hero { min-height:39rem; padding-block:5rem 4rem; display:flex; flex-direction:column; align-items:flex-start; }
	.hero .eyebrow { margin:0 0 1.3rem; color:var(--muted); }
	.hero-support { display:flex; flex:1; width:100%; flex-direction:column; align-items:flex-start; }
	h1, h2, .footer-cta { font-family:'Instrument Serif',Georgia,serif; font-weight:400; }
	h1 { margin:0; font-size:clamp(4rem,18vw,7.4rem); line-height:.86; letter-spacing:-.045em; }
	.hero-copy { max-width:31rem; margin:2rem 0 0; font-size:1.05rem; line-height:1.55; }
	.text-link, .project-link { margin-top:auto; border-bottom:1px solid currentColor; padding-bottom:.28rem; font-weight:500; }
	.project { color:#fff; overflow:hidden; }
	.project-ardu { background:var(--ardu); }
	.project-squashr { background:var(--squashr); }
	.project-inner { padding-block:3.4rem 0; }
	.project-copy { position:relative; z-index:2; }
	.project-label { margin:0 0 2.5rem; padding-bottom:.65rem; border-bottom:1px solid rgba(255,255,255,.7); width:max-content; }
	.project h2 { max-width:8.5em; margin:0; font-size:clamp(3.15rem,13vw,5.5rem); line-height:.92; letter-spacing:-.03em; }
	.project-copy > p:not(.project-label) { max-width:34rem; font-size:.98rem; line-height:1.55; margin:1.4rem 0 0; color:rgba(255,255,255,.88); }
	.tags { display:flex; flex-wrap:wrap; gap:.45rem; list-style:none; padding:0; margin:1.5rem 0 0; }
	.tags li { border:1px solid rgba(255,255,255,.55); padding:.38rem .62rem; border-radius:.22rem; font-size:.75rem; }
	.project-link { display:inline-block; margin-top:2rem; }
	.product-stage { position:relative; height:27rem; margin:2.75rem -1rem 0; overflow:hidden; }
	.ardu-stage img { position:absolute; width:19rem; max-width:none; top:0; right:-1rem; border-radius:2.2rem 2.2rem 0 0; box-shadow:0 1.5rem 5rem rgba(0,0,0,.24); }
	.squashr-stage { height:27rem; margin-right:-1rem; }
	.squashr-stage img { position:absolute; width:19rem; max-width:none; top:0; right:-1rem; border-radius:2.2rem 2.2rem 0 0; box-shadow:0 1.5rem 5rem rgba(0,0,0,.24); }
	.about { padding-block:5.5rem; display:grid; }
	.about .eyebrow { margin:0 0 1.2rem; color:var(--muted); }
	.about h2 { margin:0 0 1.4rem; max-width:11em; font-size:2.65rem; line-height:.98; }
	.about-copy > p:not(.eyebrow) { max-width:39rem; line-height:1.6; }
	.about-link { display:inline-block; margin-top:1.4rem; padding-bottom:.28rem; border-bottom:1px solid currentColor; font-weight:500; }
	.footer { background:#101310; color:#f5f1e8; }
	.footer-inner { padding-block:4rem 2rem; }
	.footer .eyebrow { margin:0 0 2rem; color:#abaea7; }
	.footer-cta { display:block; padding-bottom:2.5rem; border-bottom:1px solid #74776f; font-size:clamp(3.7rem,15vw,7.5rem); line-height:.82; letter-spacing:-.035em; }
	.footer-meta { display:grid; gap:.7rem; padding-top:1.75rem; color:#bdc0b9; font-size:.78rem; }
	@media (min-width:640px) and (max-width:959px) and (orientation:landscape) {
		.product-stage, .squashr-stage { margin-inline:0; }
		.ardu-stage img, .squashr-stage img { right:1rem; }
	}
	@media (min-width:960px) {
		.shell { width:min(100% - 5rem,1180px); }
		.site-header { padding-block:1.7rem; }
		.hero { min-height:42rem; padding-block:6rem 4.5rem; display:grid; grid-template-columns:1fr 1fr; grid-template-rows:auto 1fr; column-gap:5rem; }
		.hero .eyebrow { grid-column:1 / -1; }
		.hero h1 { grid-column:1; grid-row:2; }
		.hero-support { grid-column:2; grid-row:2; align-self:end; display:block; padding-bottom:.6rem; }
		.hero-copy { margin:0; max-width:34rem; font-size:1.25rem; }
		.hero .text-link { display:inline-block; margin-top:2rem; }
		.project-inner { min-height:50rem; padding-block:6rem; display:grid; grid-template-columns:.9fr 1.1fr; gap:5rem; align-items:center; }
		.project-squashr .project-copy { order:2; }
		.project h2 { font-size:clamp(4.3rem,6.4vw,6.8rem); }
		.product-stage { height:38rem; margin:0; overflow:visible; }
		.ardu-stage img { width:26rem; right:8%; }
		.squashr-stage { height:38rem; margin:0; }
		.squashr-stage img { width:26rem; right:8%; }
		.about { grid-template-columns:1fr 1fr; column-gap:5rem; padding-block:6.5rem; }
		.about .about-label { grid-column:1; margin-top:.45rem; }
		.about-copy { grid-column:2; }
		.about h2 { font-size:4.35rem; }
		.about-copy > p { font-size:1.08rem; }
		.footer-inner { padding-block:6rem 2.5rem; }
		.footer-meta { grid-template-columns:1fr 1fr auto; }
	}
	@media (prefers-reduced-motion:no-preference) {
		@keyframes reveal { from { opacity:0; transform:translateY(18px); } to { opacity:1; transform:none; } }
		.hero > * { animation:reveal .65s ease both; }
		.hero > :nth-child(2) { animation-delay:.08s; }
		.hero > :nth-child(3) { animation-delay:.16s; }
		.hero > :nth-child(4) { animation-delay:.24s; }
	}
	@media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } }
</style>
